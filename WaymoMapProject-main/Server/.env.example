# Copy to .env (gitignored). Backend only: no key here ever goes to the browser.

# Street View Static + Places (New). Do not use GOOGLE_API_KEY here —
# google-genai treats that name as the Gemini key.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
# one multilingual voice, used for every language
ELEVENLABS_VOICE_ID=
# optional; empty = tours are only kept as data/tours/*.json
MONGO_URI=
# comma-separated; add the Vercel + GoDaddy origins
CORS_ORIGINS=http://localhost:3000
# <1 = slower than OSM free-flow speeds; calibrate against real ride times
SPEED_FACTOR=0.8
# SERVICE_AREA=data/service_area.geojson
