# Copy to .env (gitignored). Backend only: no key here ever goes to the browser.

# Street View Static + Places (New). Do not use GOOGLE_API_KEY here —
# some SDKs treat that name as their own key.
GOOGLE_MAPS_API_KEY=

# LiteLLM proxy (ranking + Glimmer vision + scripts). sk-… keys are virtual keys on that proxy only.
# LLM_BASE_URL = host where the proxy exposes OpenAI chat completions (always include /v1):
#   http://127.0.0.1:4000/v1   (default LiteLLM listen port when run locally)
#   https://<team-litellm-host>/v1
# Not api.openai.com, Meta, or NVIDIA NIM — those are upstream; this app talks only to the proxy.
# Model ids must match the proxy model_list (same style as openai/gpt-oss-120b).
# Use LLM_API_KEY only (not a second OPENAI_API_KEY). config.py falls back to OPENAI_API_KEY
# only if LLM_API_KEY is unset — for a real OpenAI.com key without a proxy, not for duplicate sk- keys.
LLM_API_KEY=
LLM_BASE_URL=
# Model ids must match GET …/v1/models on your proxy (UF example: gpt-oss-120b, meta-muse-glimmer-30b).
LLM_MODEL=gpt-oss-120b
IDENTIFY_MODEL=meta-muse-glimmer-30b
# Flag when |AI score - (Google stars*2)| >= this (both on 0-10 scale)
VERIFY_GAP=2

ELEVENLABS_API_KEY=
# one multilingual voice, used for every language
ELEVENLABS_VOICE_ID=
# optional; empty = tours are only kept as data/tours/*.json
MONGO_URI=
# optional: free key from fl511.com (developer signup) for live road closures in the safety layer
FL511_API_KEY=
# comma-separated exact origins (scheme + host, no path). Production: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
# optional regex for Vercel preview URLs, e.g. https://your-project-.*\.vercel\.app
CORS_ORIGIN_REGEX=
# <1 = slower than OSM free-flow speeds; calibrate against real ride times
SPEED_FACTOR=0.8
# grow the traced Waymo polygon by this many miles (0 = as traced). Delete data/graph.graphml after changing it.
# 10 miles is ~680 sq mi (huge graph, 100k+ frames); 3 miles is ~180 sq mi. See Server/README.md before running the pipeline.
AREA_BUFFER_MILES=0
# SERVICE_AREA=data/service_area.geojson
